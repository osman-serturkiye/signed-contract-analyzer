# Python OCR + Report Microservice Konfigurasyonu
# Bu dosyayi .env olarak kopyalayip degerlerinizi girin

# Servis adresi ve portu
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8765

# API guvenlik anahtari - MUTLAKA degistirin!
# Java tarafinda OCR_CONFIG ve REPORT_CONFIG altinda ayni key kullanilir
SERVICE_API_KEY=change-me-secret-key

# Log seviyesi: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# WeasyPrint yerine Playwright kullanmak icin: true
USE_PLAYWRIGHT_FOR_PDF=false

# PaddleOCR model dili (tr: Turkce, en: Ingilizce, ch: Cin)
PADDLE_LANG=tr

# Surya OCR model cache dizini (bos birakilirsa varsayilan kullanilir)
SURYA_MODEL_CACHE=
